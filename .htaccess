# LeBonAuto — config Apache (Hostinger mutualise)
<IfModule mod_rewrite.c>
RewriteEngine On
# Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# URLs propres : /page.html -> /page (redirection), puis /page servi depuis /page.html en interne
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteRule ^ %1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
# Cache navigateur : court pour JS/CSS (mises à jour fréquentes via l'admin),
# long pour images/vidéo (noms uniques à chaque nouvel upload)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/png "access plus 6 months"
ExpiresByType video/mp4 "access plus 6 months"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
# Bloque l'accès web au dépôt git (ne devrait jamais être en ligne)
RedirectMatch 404 /\.git
# Donnees du site (modifiees via l'admin) : jamais en cache => mises a jour instantanees
<IfModule mod_headers.c>
<FilesMatch "(vehicles|blog)\.js$">
Header set Cache-Control "no-store, must-revalidate"
</FilesMatch>
</IfModule>
